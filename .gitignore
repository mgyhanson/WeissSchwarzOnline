# ---------------------------------------------------------------------------
# 依賴及建置輸出（實際目錄以 .nosync 結尾，不會被 iCloud 同步）
# ---------------------------------------------------------------------------
node_modules
node_modules/
node_modules.nosync/
dist/
dist.nosync/
build/
coverage/
coverage.nosync/
.cache/
.cache.nosync/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# 密碼、金鑰及環境設定（任何秘密資料都不可進入版本庫）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
*.keystore
secrets/
credentials*.json
.npmrc

# ---------------------------------------------------------------------------
# 執行期資料（本機資料庫可能含私人資料；SQLite 不可同步、不入版本庫）
# ---------------------------------------------------------------------------
data.nosync/
backups/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# 第三方版權素材（未獲授權，不可上傳）
# ---------------------------------------------------------------------------
# 官方規則 PDF 只作私人離線對照
rules/sources/*.pdf
# 使用者自行放置的卡圖
card-assets/local.nosync/
# 任何官方卡圖。專案自製的佔位圖放在 card-assets/placeholders/
card-assets/official/
card-assets/**/*.png
card-assets/**/*.jpg
card-assets/**/*.jpeg
card-assets/**/*.webp
card-assets/**/*.gif
!card-assets/placeholders/**

# ---------------------------------------------------------------------------
# 暫存、日誌及測試輸出
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
*.tmp
*.swp
tmp/
playwright-report/
test-results/

# ---------------------------------------------------------------------------
# 系統及編輯器檔案
# ---------------------------------------------------------------------------
.DS_Store
*.icloud
.idea/
.vscode/*
!.vscode/extensions.json

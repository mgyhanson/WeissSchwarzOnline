{
  "name": "weiss-schwarz-online",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial community simulator for the Weiss Schwarz trading card game",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "game-engine",
    "card-database",
    "ai",
    "backend",
    "web-client"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p game-engine --noEmit && tsc -p card-database --noEmit && tsc -p ai --noEmit && tsc -p backend --noEmit && tsc -p web-client --noEmit && tsc -p . --noEmit",
    "check": "npm run typecheck && npm run test && node scripts/registry.ts --check",
    "backup": "bash scripts/backup.sh",
    "registry": "node scripts/registry.ts",
    "soak": "SOAK=1000 vitest run game-engine/tests/soak.test.ts",
    "dev": "npm run dev -w web-client",
    "build": "npm run build -w web-client",
    "dev:lan": "npm run dev -w web-client -- --host",
    "ai:tournament": "AI_TOURNAMENT=1 vitest run ai/tests/tournament.test.ts",
    "ai:fit": "AI_FIT=1 vitest run ai/tests/fit-evaluation.test.ts",
    "qa:ui": "node tests/e2e/ui-qa.mjs",
    "server:build": "esbuild backend/src/main.ts --bundle --platform=node --format=esm --target=node24 --external:ws --log-level=warning --outfile=backend/dist.nosync/server.mjs",
    "server": "npm run build && npm run server:build && node backend/dist.nosync/server.mjs",
    "server:lan": "npm run build && npm run server:build && node backend/dist.nosync/server.mjs --lan",
    "server:dev": "npm run server:build && node backend/dist.nosync/server.mjs",
    "qa:online": "npm run build && npm run server:build && node tests/e2e/online-qa.mjs",
    "cards:import": "node scripts/import-card-sets.ts",
    "cards:images": "node scripts/import-image-pack.ts",
    "cards:images:index": "node scripts/index-user-images.ts",
    "cards:validate": "node scripts/validate-card-database.ts",
    "cards:report": "CARD_REPORT=1 vitest run card-database/tests/stats.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

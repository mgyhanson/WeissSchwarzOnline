{
  "name": "weiss-schwarz-online",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial community simulator for the Weiss Schwarz trading card game",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "game-engine",
    "card-database"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p game-engine --noEmit && tsc -p card-database --noEmit && tsc -p . --noEmit",
    "check": "npm run typecheck && npm run test && node scripts/registry.ts --check",
    "backup": "bash scripts/backup.sh",
    "registry": "node scripts/registry.ts",
    "soak": "SOAK=1000 vitest run game-engine/tests/soak.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
